rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Perfil de usuario: permitimos que todos vean quiénes son los invitados
    match /users/{userId} {
      allow read: if request.auth != null; 
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Reglas para eventos y sus contenidos (fotos/chat)
    match /events/{eventId} {
      allow read: if true;
      allow write: if request.auth != null; 

      match /photos/{photoId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && (
          resource.data.userId == request.auth.uid || 
          get(/databases/$(database)/documents/events/$(eventId)/guests/$(request.auth.uid)).data.role == 'admin'
        );
      }

      match /chat/{messageId} {
        allow read: if true;
        allow create: if request.auth != null;
      }

      match /guests/{guestId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == guestId;
      }
    }
  }
}
